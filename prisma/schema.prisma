generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ContentStatus {
  Draft
  Review
  Ready
  Scheduled
}

enum GeoFlowTaskStatus {
  not_sent
  queued
  generating
  reviewing
  published
  failed
}

model ContentAsset {
  id             String            @id
  title          String
  body           String
  summary        String
  brandEntity    String
  sourceUrl      String
  targetKeywords String[]
  canonicalUrl   String
  status         ContentStatus     @default(Draft)
  geoScore       Int               @default(0)
  owner          String
  sourceSystem   String            @default("geo_ops")
  externalUrl    String?
  publishedAt    DateTime?
  slug           String?
  locale         String            @default("zh-CN")
  assetType      String            @default("guide-page")
  audience       String?
  seoTitle       String?
  metaDescription String?
  faqs           Json?
  schemaType     String            @default("article")
  ctaMode        String            @default("self_signup")
  publishTarget  String            @default("geo_ops_internal")
  isPublic       Boolean           @default(false)
  publishedPath  String?
  seoScore       Int?
  trendTopicId   String?
  templateId     String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  geoFlowLinks   GeoFlowTaskLink[]
  geoRuns        GeoRun[]
  trendTopic     TrendTopic?       @relation(fields: [trendTopicId], references: [id])
  variants       ChannelVariant[]

  @@index([status])
  @@index([sourceSystem])
  @@index([publishedAt])
  @@index([publishTarget, isPublic])
  @@index([locale, slug])
}

model GeoRun {
  id              String        @id
  projectId       String
  contentAssetId  String?
  contentAsset    ContentAsset? @relation(fields: [contentAssetId], references: [id], onDelete: SetNull)
  prompt          String
  provider        String
  locale          String
  competitors     String[]
  modelAnswer     String
  brandMentioned  Boolean
  citedDomains    String[]
  score           Int
  recommendations Json
  mode            String
  createdAt       DateTime

  @@index([projectId])
  @@index([contentAssetId])
  @@index([provider])
  @@index([createdAt])
}

model ChannelVariant {
  id             String       @id
  contentAssetId String
  contentAsset   ContentAsset @relation(fields: [contentAssetId], references: [id], onDelete: Cascade)
  platform       String
  accountId      String
  copy           String
  mediaAssets    String[]
  scheduledAt    DateTime?
  status         String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  metrics        VariantMetric[]

  @@index([contentAssetId])
  @@index([platform])
  @@index([status])
  @@index([scheduledAt])
}

model GeoFlowTaskLink {
  id                String            @id @default(cuid())
  contentAssetId    String
  contentAsset      ContentAsset      @relation(fields: [contentAssetId], references: [id], onDelete: Cascade)
  geoFlowTaskId     Int?
  geoFlowJobId      Int?
  geoFlowArticleId  Int?
  geoFlowArticleUrl String?
  status            GeoFlowTaskStatus @default(not_sent)
  lastSyncedAt      DateTime?
  lastError         String?
  idempotencyKey    String            @unique
  taskPayload       Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([contentAssetId])
  @@index([geoFlowTaskId])
  @@index([geoFlowArticleId])
  @@index([status])
  @@index([lastSyncedAt])
}

model GeoFlowSyncRun {
  id           String    @id @default(cuid())
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  successCount Int       @default(0)
  failureCount Int       @default(0)
  errorSummary String?

  @@index([startedAt])
}

model AuditEvent {
  id         String   @id @default(cuid())
  actor      String
  action     String
  entityType String
  entityId   String?
  outcome    String
  requestId  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([entityType, entityId])
  @@index([outcome])
  @@index([requestId])
}

model TrendTopic {
  id         String         @id @default(cuid())
  keyword    String
  platform   String
  score      Int
  region     String         @default("CN")
  sourceType String
  status     String         @default("pending")
  capturedAt DateTime
  expiresAt  DateTime?
  createdAt  DateTime       @default(now())
  assets     ContentAsset[]

  @@index([status])
  @@index([platform])
  @@index([capturedAt])
}

model VariantMetric {
  id               String         @id @default(cuid())
  channelVariantId String
  channelVariant   ChannelVariant @relation(fields: [channelVariantId], references: [id], onDelete: Cascade)
  impressions      Int            @default(0)
  clicks           Int            @default(0)
  shares           Int            @default(0)
  recordedAt       DateTime

  @@index([channelVariantId])
  @@index([recordedAt])
}

model SeoAudit {
  id        String   @id @default(cuid())
  url       String
  score     Int
  issues    Json
  cwv       Json?
  auditedAt DateTime

  @@index([url])
  @@index([auditedAt])
}

model KeywordRanking {
  id          String   @id @default(cuid())
  keyword     String
  url         String
  position    Int
  clicks      Int      @default(0)
  impressions Int      @default(0)
  source      String
  recordedAt  DateTime

  @@index([keyword])
  @@index([url])
  @@index([recordedAt])
}

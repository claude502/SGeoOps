generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ContentStatus {
  Draft
  Review
  Ready
  Scheduled
}

enum GeoFlowTaskStatus {
  not_sent
  queued
  generating
  reviewing
  published
  failed
}

enum ExportPackageStatus {
  ready
  claimed
  dispatched
  failed
  archived
}

enum DistributionDispatchStatus {
  accepted
  scheduled
  published
  failed
  deleted
}

enum EventDeliveryStatus {
  pending
  sent
  failed
  abandoned
}

enum MemberRole {
  Admin
  Operator
  Reviewer
  Viewer
}

enum RunStatus {
  queued
  running
  succeeded
  partial
  retrying
  failed
  cancelled
}

model ContentAsset {
  id                     String                 @id
  clientId               String
  brandId                String
  siteId                 String
  siteMarketId           String?
  title                  String
  body                   String
  summary                String
  brandEntity            String
  sourceUrl              String
  targetKeywords         String[]
  canonicalUrl           String
  status                 ContentStatus          @default(Draft)
  geoScore               Int                    @default(0)
  owner                  String
  sourceSystem           String                 @default("geo_ops")
  externalUrl            String?
  publishedAt            DateTime?
  slug                   String?
  locale                 String                 @default("zh-CN")
  assetType              String                 @default("guide-page")
  audience               String?
  seoTitle               String?
  metaDescription        String?
  faqs                   Json?
  schemaType             String                 @default("article")
  ctaMode                String                 @default("self_signup")
  publishTarget          String                 @default("geo_ops_internal")
  isPublic               Boolean                @default(false)
  publishedPath          String?
  seoScore               Int?
  trendTopicId           String?
  templateId             String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  client                 Client                 @relation("ContentAssetClient", fields: [clientId], references: [id], onDelete: Restrict)
  brand                  Brand                  @relation("ContentAssetBrand", fields: [brandId], references: [id], onDelete: Restrict)
  site                   Site                   @relation("ContentAssetSite", fields: [siteId], references: [id], onDelete: Restrict)
  siteMarket             SiteMarket?            @relation("ContentAssetSiteMarket", fields: [siteMarketId], references: [id], onDelete: Restrict)
  distributionDispatches DistributionDispatch[]
  exportPackages         ExportPackage[]
  geoFlowLinks           GeoFlowTaskLink[]
  geoRuns                GeoRun[]
  trendTopic             TrendTopic?            @relation(fields: [trendTopicId], references: [id])
  variants               ChannelVariant[]

  @@index([status])
  @@index([sourceSystem])
  @@index([publishedAt])
  @@index([publishTarget, isPublic])
  @@index([locale, slug])
  @@index([sourceSystem, trendTopicId, templateId, locale])
  @@unique([clientId, sourceSystem, trendTopicId, templateId])
  @@index([clientId, siteId])
  @@index([brandId])
  @@index([siteId])
  @@index([siteMarketId])
}

model GeoRun {
  id              String        @id
  clientId        String
  brandId         String
  siteId          String
  siteMarketId    String?
  projectId       String
  contentAssetId  String?
  contentAsset    ContentAsset? @relation(fields: [contentAssetId], references: [id], onDelete: SetNull)
  prompt          String
  provider        String
  locale          String
  competitors     String[]
  modelAnswer     String
  brandMentioned  Boolean
  citedDomains    String[]
  score           Int
  recommendations Json
  mode            String
  createdAt       DateTime
  client          Client        @relation("GeoRunClient", fields: [clientId], references: [id], onDelete: Restrict)
  brand           Brand         @relation("GeoRunBrand", fields: [brandId], references: [id], onDelete: Restrict)
  site            Site          @relation("GeoRunSite", fields: [siteId], references: [id], onDelete: Restrict)
  siteMarket      SiteMarket?   @relation("GeoRunSiteMarket", fields: [siteMarketId], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([contentAssetId])
  @@index([provider])
  @@index([createdAt])
  @@index([clientId, siteId])
  @@index([brandId])
  @@index([siteId])
  @@index([siteMarketId])
}

model ChannelVariant {
  id             String          @id
  clientId       String
  brandId        String
  siteId         String
  siteMarketId   String?
  contentAssetId String
  contentAsset   ContentAsset    @relation(fields: [contentAssetId], references: [id], onDelete: Cascade)
  platform       String
  accountId      String
  copy           String
  mediaAssets    String[]
  scheduledAt    DateTime?
  status         String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  client         Client          @relation("ChannelVariantClient", fields: [clientId], references: [id], onDelete: Restrict)
  brand          Brand           @relation("ChannelVariantBrand", fields: [brandId], references: [id], onDelete: Restrict)
  site           Site            @relation("ChannelVariantSite", fields: [siteId], references: [id], onDelete: Restrict)
  siteMarket     SiteMarket?     @relation("ChannelVariantSiteMarket", fields: [siteMarketId], references: [id], onDelete: Restrict)
  metrics        VariantMetric[]

  @@index([contentAssetId])
  @@index([platform])
  @@index([status])
  @@index([scheduledAt])
  @@index([clientId, siteId])
  @@index([brandId])
  @@index([siteId])
  @@index([siteMarketId])
}

model GeoFlowTaskLink {
  id                String            @id @default(cuid())
  clientId          String
  brandId           String
  siteId            String
  siteMarketId      String?
  contentAssetId    String
  contentAsset      ContentAsset      @relation(fields: [contentAssetId], references: [id], onDelete: Cascade)
  geoFlowTaskId     Int?
  geoFlowJobId      Int?
  geoFlowArticleId  Int?
  geoFlowArticleUrl String?
  status            GeoFlowTaskStatus @default(not_sent)
  lastSyncedAt      DateTime?
  lastError         String?
  idempotencyKey    String            @unique
  taskPayload       Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  client            Client            @relation("GeoFlowTaskLinkClient", fields: [clientId], references: [id], onDelete: Restrict)
  brand             Brand             @relation("GeoFlowTaskLinkBrand", fields: [brandId], references: [id], onDelete: Restrict)
  site              Site              @relation("GeoFlowTaskLinkSite", fields: [siteId], references: [id], onDelete: Restrict)
  siteMarket        SiteMarket?       @relation("GeoFlowTaskLinkSiteMarket", fields: [siteMarketId], references: [id], onDelete: Restrict)

  @@index([contentAssetId])
  @@index([geoFlowTaskId])
  @@index([geoFlowArticleId])
  @@index([status])
  @@index([lastSyncedAt])
  @@index([clientId, siteId])
  @@index([brandId])
  @@index([siteId])
  @@index([siteMarketId])
}

model GeoFlowSyncRun {
  id           String      @id @default(cuid())
  clientId     String
  brandId      String
  siteId       String
  siteMarketId String?
  startedAt    DateTime    @default(now())
  finishedAt   DateTime?
  successCount Int         @default(0)
  failureCount Int         @default(0)
  errorSummary String?
  client       Client      @relation("GeoFlowSyncRunClient", fields: [clientId], references: [id], onDelete: Restrict)
  brand        Brand       @relation("GeoFlowSyncRunBrand", fields: [brandId], references: [id], onDelete: Restrict)
  site         Site        @relation("GeoFlowSyncRunSite", fields: [siteId], references: [id], onDelete: Restrict)
  siteMarket   SiteMarket? @relation("GeoFlowSyncRunSiteMarket", fields: [siteMarketId], references: [id], onDelete: Restrict)

  @@index([startedAt])
  @@index([clientId, siteId])
  @@index([brandId])
  @@index([siteId])
  @@index([siteMarketId])
}

model AuditEvent {
  id           String      @id @default(cuid())
  clientId     String
  brandId      String
  siteId       String
  siteMarketId String?
  actor        String
  action       String
  entityType   String
  entityId     String?
  outcome      String
  requestId    String?
  metadata     Json?
  createdAt    DateTime    @default(now())
  client       Client      @relation("AuditEventClient", fields: [clientId], references: [id], onDelete: Restrict)
  brand        Brand       @relation("AuditEventBrand", fields: [brandId], references: [id], onDelete: Restrict)
  site         Site        @relation("AuditEventSite", fields: [siteId], references: [id], onDelete: Restrict)
  siteMarket   SiteMarket? @relation("AuditEventSiteMarket", fields: [siteMarketId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([action])
  @@index([entityType, entityId])
  @@index([entityId])
  @@index([outcome])
  @@index([requestId])
  @@index([clientId, siteId])
  @@index([brandId])
  @@index([siteId])
  @@index([siteMarketId])
}

model TrendTopic {
  id           String         @id @default(cuid())
  clientId     String
  brandId      String
  siteId       String
  siteMarketId String?
  keyword      String
  platform     String
  score        Int
  region       String         @default("CN")
  sourceType   String
  status       String         @default("pending")
  capturedAt   DateTime
  expiresAt    DateTime?
  createdAt    DateTime       @default(now())
  client       Client         @relation("TrendTopicClient", fields: [clientId], references: [id], onDelete: Restrict)
  brand        Brand          @relation("TrendTopicBrand", fields: [brandId], references: [id], onDelete: Restrict)
  site         Site           @relation("TrendTopicSite", fields: [siteId], references: [id], onDelete: Restrict)
  siteMarket   SiteMarket?    @relation("TrendTopicSiteMarket", fields: [siteMarketId], references: [id], onDelete: Restrict)
  assets       ContentAsset[]

  @@unique([clientId, keyword, platform])
  @@index([status])
  @@index([platform])
  @@index([capturedAt])
  @@index([clientId, siteId])
  @@index([brandId])
  @@index([siteId])
  @@index([siteMarketId])
}

model VariantMetric {
  id               String         @id @default(cuid())
  clientId         String
  brandId          String
  siteId           String
  siteMarketId     String?
  channelVariantId String
  channelVariant   ChannelVariant @relation(fields: [channelVariantId], references: [id], onDelete: Cascade)
  impressions      Int            @default(0)
  clicks           Int            @default(0)
  shares           Int            @default(0)
  recordedAt       DateTime
  client           Client         @relation("VariantMetricClient", fields: [clientId], references: [id], onDelete: Restrict)
  brand            Brand          @relation("VariantMetricBrand", fields: [brandId], references: [id], onDelete: Restrict)
  site             Site           @relation("VariantMetricSite", fields: [siteId], references: [id], onDelete: Restrict)
  siteMarket       SiteMarket?    @relation("VariantMetricSiteMarket", fields: [siteMarketId], references: [id], onDelete: Restrict)

  @@index([channelVariantId])
  @@index([recordedAt])
  @@index([clientId, siteId])
  @@index([brandId])
  @@index([siteId])
  @@index([siteMarketId])
}

model SeoAudit {
  id           String      @id @default(cuid())
  clientId     String
  brandId      String
  siteId       String
  siteMarketId String?
  url          String
  score        Int
  issues       Json
  cwv          Json?
  auditedAt    DateTime
  client       Client      @relation("SeoAuditClient", fields: [clientId], references: [id], onDelete: Restrict)
  brand        Brand       @relation("SeoAuditBrand", fields: [brandId], references: [id], onDelete: Restrict)
  site         Site        @relation("SeoAuditSite", fields: [siteId], references: [id], onDelete: Restrict)
  siteMarket   SiteMarket? @relation("SeoAuditSiteMarket", fields: [siteMarketId], references: [id], onDelete: Restrict)

  @@index([url])
  @@index([auditedAt])
  @@index([clientId, siteId])
  @@index([brandId])
  @@index([siteId])
  @@index([siteMarketId])
}

model KeywordRanking {
  id           String      @id @default(cuid())
  clientId     String
  brandId      String
  siteId       String
  siteMarketId String?
  keyword      String
  url          String
  position     Int
  clicks       Int         @default(0)
  impressions  Int         @default(0)
  source       String
  recordedAt   DateTime
  client       Client      @relation("KeywordRankingClient", fields: [clientId], references: [id], onDelete: Restrict)
  brand        Brand       @relation("KeywordRankingBrand", fields: [brandId], references: [id], onDelete: Restrict)
  site         Site        @relation("KeywordRankingSite", fields: [siteId], references: [id], onDelete: Restrict)
  siteMarket   SiteMarket? @relation("KeywordRankingSiteMarket", fields: [siteMarketId], references: [id], onDelete: Restrict)

  @@index([keyword])
  @@index([url])
  @@index([recordedAt])
  @@index([clientId, siteId])
  @@index([brandId])
  @@index([siteId])
  @@index([siteMarketId])
}

model ExportPackage {
  id                     String                 @id @default(cuid())
  clientId               String
  brandId                String
  siteId                 String
  siteMarketId           String?
  contentAssetId         String
  contentAsset           ContentAsset           @relation(fields: [contentAssetId], references: [id], onDelete: Cascade)
  version                Int                    @default(1)
  language               String                 @default("zh-CN")
  status                 ExportPackageStatus    @default(ready)
  packageType            String
  payload                Json?
  recommendedPlatforms   String[]
  sourceUrl              String
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  client                 Client                 @relation("ExportPackageClient", fields: [clientId], references: [id], onDelete: Restrict)
  brand                  Brand                  @relation("ExportPackageBrand", fields: [brandId], references: [id], onDelete: Restrict)
  site                   Site                   @relation("ExportPackageSite", fields: [siteId], references: [id], onDelete: Restrict)
  siteMarket             SiteMarket?            @relation("ExportPackageSiteMarket", fields: [siteMarketId], references: [id], onDelete: Restrict)
  distributionDispatches DistributionDispatch[]

  @@unique([contentAssetId, version, language])
  @@index([contentAssetId])
  @@index([status])
  @@index([clientId, siteId])
  @@index([brandId])
  @@index([siteId])
  @@index([siteMarketId])
}

model DistributionDispatch {
  id              String                     @id @default(cuid())
  clientId        String
  brandId         String
  siteId          String
  siteMarketId    String?
  exportPackageId String
  exportPackage   ExportPackage              @relation(fields: [exportPackageId], references: [id], onDelete: Cascade)
  contentAssetId  String
  contentAsset    ContentAsset               @relation(fields: [contentAssetId], references: [id], onDelete: Cascade)
  platform        String
  accountId       String
  externalPostId  String?
  publishedUrl    String?
  status          DistributionDispatchStatus @default(accepted)
  errorMessage    String?
  publishedAt     DateTime?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  client          Client                     @relation("DistributionDispatchClient", fields: [clientId], references: [id], onDelete: Restrict)
  brand           Brand                      @relation("DistributionDispatchBrand", fields: [brandId], references: [id], onDelete: Restrict)
  site            Site                       @relation("DistributionDispatchSite", fields: [siteId], references: [id], onDelete: Restrict)
  siteMarket      SiteMarket?                @relation("DistributionDispatchSiteMarket", fields: [siteMarketId], references: [id], onDelete: Restrict)

  @@index([exportPackageId])
  @@index([contentAssetId])
  @@index([platform, status])
  @@index([clientId, siteId])
  @@index([brandId])
  @@index([siteId])
  @@index([siteMarketId])
}

model EventDelivery {
  id            String              @id @default(cuid())
  clientId      String
  brandId       String
  siteId        String
  siteMarketId  String?
  eventName     String
  entityType    String
  entityId      String
  payload       Json?
  target        String
  status        EventDeliveryStatus @default(pending)
  attemptCount  Int                 @default(0)
  lastError     String?
  lastAttemptAt DateTime?
  createdAt     DateTime            @default(now())
  client        Client              @relation("EventDeliveryClient", fields: [clientId], references: [id], onDelete: Restrict)
  brand         Brand               @relation("EventDeliveryBrand", fields: [brandId], references: [id], onDelete: Restrict)
  site          Site                @relation("EventDeliverySite", fields: [siteId], references: [id], onDelete: Restrict)
  siteMarket    SiteMarket?         @relation("EventDeliverySiteMarket", fields: [siteMarketId], references: [id], onDelete: Restrict)

  @@index([eventName, status])
  @@index([entityType, entityId])
  @@index([entityId])
  @@index([createdAt])
  @@index([clientId, siteId])
  @@index([brandId])
  @@index([siteId])
  @@index([siteMarketId])
}

model Workspace {
  id        String            @id @default(cuid())
  name      String
  slug      String            @unique
  clients   Client[]
  members   WorkspaceMember[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model User {
  id            String            @id
  name          String
  email         String            @unique
  emailVerified Boolean           @default(false)
  image         String?
  sessions      Session[]
  accounts      Account[]
  memberships   WorkspaceMember[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model WorkspaceMember {
  id          String     @id @default(cuid())
  workspaceId String
  userId      String
  role        MemberRole
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([workspaceId, userId])
  @@index([userId, role])
}

model Client {
  id                     String                 @id @default(cuid())
  workspaceId            String
  name                   String
  slug                   String
  active                 Boolean                @default(true)
  workspace              Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  brands                 Brand[]
  analysisRuns           AnalysisRun[]
  recommendations        Recommendation[]
  opportunities          Opportunity[]
  contentAssets          ContentAsset[]         @relation("ContentAssetClient")
  geoRuns                GeoRun[]               @relation("GeoRunClient")
  channelVariants        ChannelVariant[]       @relation("ChannelVariantClient")
  geoFlowTaskLinks       GeoFlowTaskLink[]      @relation("GeoFlowTaskLinkClient")
  geoFlowSyncRuns        GeoFlowSyncRun[]       @relation("GeoFlowSyncRunClient")
  auditEvents            AuditEvent[]           @relation("AuditEventClient")
  trendTopics            TrendTopic[]           @relation("TrendTopicClient")
  variantMetrics         VariantMetric[]        @relation("VariantMetricClient")
  seoAudits              SeoAudit[]             @relation("SeoAuditClient")
  keywordRankings        KeywordRanking[]       @relation("KeywordRankingClient")
  exportPackages         ExportPackage[]        @relation("ExportPackageClient")
  distributionDispatches DistributionDispatch[] @relation("DistributionDispatchClient")
  eventDeliveries        EventDelivery[]        @relation("EventDeliveryClient")
  providerBudgets        ProviderBudget[]
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@unique([workspaceId, slug])
  @@index([workspaceId, active])
}

model Brand {
  id                     String                 @id @default(cuid())
  clientId               String
  name                   String
  slug                   String
  aliases                String[]
  products               Json?
  industry               String?
  goals                  Json?
  riskCategory           String                 @default("standard")
  client                 Client                 @relation(fields: [clientId], references: [id], onDelete: Restrict)
  sites                  Site[]
  competitors            Competitor[]
  analysisRuns           AnalysisRun[]
  contentAssets          ContentAsset[]         @relation("ContentAssetBrand")
  geoRuns                GeoRun[]               @relation("GeoRunBrand")
  channelVariants        ChannelVariant[]       @relation("ChannelVariantBrand")
  geoFlowTaskLinks       GeoFlowTaskLink[]      @relation("GeoFlowTaskLinkBrand")
  geoFlowSyncRuns        GeoFlowSyncRun[]       @relation("GeoFlowSyncRunBrand")
  auditEvents            AuditEvent[]           @relation("AuditEventBrand")
  trendTopics            TrendTopic[]           @relation("TrendTopicBrand")
  variantMetrics         VariantMetric[]        @relation("VariantMetricBrand")
  seoAudits              SeoAudit[]             @relation("SeoAuditBrand")
  keywordRankings        KeywordRanking[]       @relation("KeywordRankingBrand")
  exportPackages         ExportPackage[]        @relation("ExportPackageBrand")
  distributionDispatches DistributionDispatch[] @relation("DistributionDispatchBrand")
  eventDeliveries        EventDelivery[]        @relation("EventDeliveryBrand")
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@unique([clientId, slug])
  @@index([clientId])
}

model Site {
  id                     String                 @id @default(cuid())
  brandId                String
  name                   String
  canonicalHost          String                 @unique
  originHosts            String[]
  siteType               String
  hostingMode            String
  canonicalRules         Json
  allowedPublishPaths    String[]
  ownershipVerifiedAt    DateTime?
  active                 Boolean                @default(true)
  brand                  Brand                  @relation(fields: [brandId], references: [id], onDelete: Restrict)
  markets                SiteMarket[]
  integrations           Integration[]
  analysisRuns           AnalysisRun[]
  recommendations        Recommendation[]
  opportunities          Opportunity[]
  contentAssets          ContentAsset[]         @relation("ContentAssetSite")
  geoRuns                GeoRun[]               @relation("GeoRunSite")
  channelVariants        ChannelVariant[]       @relation("ChannelVariantSite")
  geoFlowTaskLinks       GeoFlowTaskLink[]      @relation("GeoFlowTaskLinkSite")
  geoFlowSyncRuns        GeoFlowSyncRun[]       @relation("GeoFlowSyncRunSite")
  auditEvents            AuditEvent[]           @relation("AuditEventSite")
  trendTopics            TrendTopic[]           @relation("TrendTopicSite")
  variantMetrics         VariantMetric[]        @relation("VariantMetricSite")
  seoAudits              SeoAudit[]             @relation("SeoAuditSite")
  keywordRankings        KeywordRanking[]       @relation("KeywordRankingSite")
  exportPackages         ExportPackage[]        @relation("ExportPackageSite")
  distributionDispatches DistributionDispatch[] @relation("DistributionDispatchSite")
  eventDeliveries        EventDelivery[]        @relation("EventDeliverySite")
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@index([brandId, active])
}

model SiteMarket {
  id                     String                 @id @default(cuid())
  siteId                 String
  country                String
  locale                 String
  defaultDevice          String                 @default("desktop")
  timezone               String
  settings               Json?
  site                   Site                   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  competitors            Competitor[]
  keywords               Keyword[]
  integrations           Integration[]
  analysisRuns           AnalysisRun[]
  contentAssets          ContentAsset[]         @relation("ContentAssetSiteMarket")
  geoRuns                GeoRun[]               @relation("GeoRunSiteMarket")
  channelVariants        ChannelVariant[]       @relation("ChannelVariantSiteMarket")
  geoFlowTaskLinks       GeoFlowTaskLink[]      @relation("GeoFlowTaskLinkSiteMarket")
  geoFlowSyncRuns        GeoFlowSyncRun[]       @relation("GeoFlowSyncRunSiteMarket")
  auditEvents            AuditEvent[]           @relation("AuditEventSiteMarket")
  trendTopics            TrendTopic[]           @relation("TrendTopicSiteMarket")
  variantMetrics         VariantMetric[]        @relation("VariantMetricSiteMarket")
  seoAudits              SeoAudit[]             @relation("SeoAuditSiteMarket")
  keywordRankings        KeywordRanking[]       @relation("KeywordRankingSiteMarket")
  exportPackages         ExportPackage[]        @relation("ExportPackageSiteMarket")
  distributionDispatches DistributionDispatch[] @relation("DistributionDispatchSiteMarket")
  eventDeliveries        EventDelivery[]        @relation("EventDeliverySiteMarket")
  prompts                Prompt[]
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@unique([siteId, country, locale])
  @@index([siteId])
}

model Competitor {
  id           String      @id @default(cuid())
  brandId      String
  siteMarketId String?
  name         String
  aliases      String[]
  active       Boolean     @default(true)
  brand        Brand       @relation(fields: [brandId], references: [id], onDelete: Cascade)
  siteMarket   SiteMarket? @relation(fields: [siteMarketId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // SQL-only partial unique: ("brandId", "name") WHERE "siteMarketId" IS NULL.
  @@unique([brandId, siteMarketId, name])
  @@index([brandId, active])
  @@index([siteMarketId])
}

model Keyword {
  id           String     @id @default(cuid())
  siteMarketId String
  text         String
  targetUrl    String?
  country      String
  device       String
  location     String     @default("*")
  priority     Int        @default(3)
  schedule     String
  active       Boolean    @default(true)
  siteMarket   SiteMarket @relation(fields: [siteMarketId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([siteMarketId, text, country, device, location])
  @@index([siteMarketId, active])
}

model Integration {
  id             String      @id @default(cuid())
  siteId         String
  siteMarketId   String?
  type           String
  endpoint       String?
  capabilities   String[]
  adapterVersion String
  secretRef      String?
  healthState    String      @default("unknown")
  lastCheckedAt  DateTime?
  site           Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteMarket     SiteMarket? @relation(fields: [siteMarketId], references: [id], onDelete: Cascade)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // SQL-only partial unique: ("siteId", "type") WHERE "siteMarketId" IS NULL.
  @@unique([siteId, siteMarketId, type])
  @@index([siteId, healthState])
  @@index([siteMarketId])
}

model AnalysisRun {
  id              String           @id
  clientId        String
  brandId         String
  siteId          String
  siteMarketId    String?
  kind            String
  source          String
  sourceVersion   String
  adapterVersion  String
  status          RunStatus
  inputHash       String
  idempotencyKey  String           @unique
  trigger         String
  attemptCount    Int              @default(0)
  promptId        String?
  provider        String?
  model           String?
  surface         String?
  latencyMs       Int?
  inputTokens     Int?
  outputTokens    Int?
  costUsd         Decimal?         @db.Decimal(18, 6)
  errorCode       String?
  errorSummary    String?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime         @default(now())
  artifacts       RawArtifact[]
  observations    Observation[]
  metrics         MetricSnapshot[]
  recommendations Recommendation[]
  client          Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  brand           Brand            @relation(fields: [brandId], references: [id], onDelete: Restrict)
  site            Site             @relation(fields: [siteId], references: [id], onDelete: Restrict)
  siteMarket      SiteMarket?      @relation(fields: [siteMarketId], references: [id], onDelete: Restrict)
  prompt          Prompt?          @relation(fields: [promptId], references: [id], onDelete: SetNull)

  @@index([siteId, kind, inputHash])
  @@index([clientId, siteId, createdAt])
  @@index([status, createdAt])
  @@index([brandId])
  @@index([siteMarketId])
  @@index([promptId])
  @@index([siteMarketId, provider, finishedAt])
}

model Prompt {
  id            String        @id @default(cuid())
  siteMarketId  String
  text          String
  intent        String
  topic         String
  locale        String
  country       String
  providers     String[]
  searchEnabled Boolean       @default(false)
  version       Int           @default(1)
  schedule      String
  active        Boolean       @default(true)
  siteMarket    SiteMarket    @relation(fields: [siteMarketId], references: [id], onDelete: Cascade)
  analysisRuns  AnalysisRun[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([siteMarketId, active])
}

model ProviderBudget {
  id                String          @id @default(cuid())
  clientId          String
  provider          String
  dailyRequestLimit Int
  dailyTokenLimit   Int?
  active            Boolean         @default(true)
  client            Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  usages            ProviderUsage[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([clientId, provider])
}

model ProviderUsage {
  id           String         @id @default(cuid())
  budgetId     String
  usageDate    DateTime       @db.Date
  requestCount Int            @default(0)
  inputTokens  Int            @default(0)
  outputTokens Int            @default(0)
  costUsd      Decimal        @default(0) @db.Decimal(18, 6)
  budget       ProviderBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([budgetId, usageDate])
}

model RawArtifact {
  id            String      @id @default(cuid())
  runId         String
  uri           String      @unique
  mediaType     String
  checksum      String
  byteSize      Int
  sourceVersion String
  retentionAt   DateTime
  redacted      Boolean     @default(false)
  run           AnalysisRun @relation(fields: [runId], references: [id], onDelete: Restrict)
  createdAt     DateTime    @default(now())

  @@index([runId])
  @@index([retentionAt])
}

model Observation {
  id                     String                   @id @default(cuid())
  runId                  String
  kind                   String
  subject                String
  value                  Json
  surface                String?
  provider               String?
  model                  String?
  promptVersion          Int?
  country                String?
  locale                 String?
  observedAt             DateTime
  run                    AnalysisRun              @relation(fields: [runId], references: [id], onDelete: Restrict)
  recommendationEvidence RecommendationEvidence[]

  @@index([runId, kind])
  @@index([kind, observedAt])
}

model MetricSnapshot {
  id             String      @id @default(cuid())
  runId          String
  name           String
  value          Decimal     @db.Decimal(18, 6)
  dimensions     Json
  formulaVersion String
  calculatedAt   DateTime    @default(now())
  run            AnalysisRun @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@index([runId, name])
}

model Recommendation {
  id                String                      @id @default(cuid())
  runId             String
  clientId          String
  siteId            String
  title             String
  detail            String
  priority          Decimal                     @db.Decimal(10, 4)
  formulaVersion    String
  state             String                      @default("open")
  ownerId           String?
  dueAt             DateTime?
  resolution        String?
  verificationRunId String?
  run               AnalysisRun                 @relation(fields: [runId], references: [id], onDelete: Restrict)
  client            Client                      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  site              Site                        @relation(fields: [siteId], references: [id], onDelete: Restrict)
  evidence          RecommendationEvidence[]
  opportunities     OpportunityRecommendation[]
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  @@index([clientId, siteId, state])
  @@index([runId])
  @@index([siteId])
}

model RecommendationEvidence {
  recommendationId String
  observationId    String
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  observation      Observation    @relation(fields: [observationId], references: [id], onDelete: Restrict)

  @@id([recommendationId, observationId])
  @@index([observationId])
}

model Opportunity {
  id              String                      @id @default(cuid())
  clientId        String
  siteId          String
  title           String
  state           String                      @default("open")
  priority        Decimal                     @db.Decimal(10, 4)
  formulaVersion  String
  client          Client                      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  site            Site                        @relation(fields: [siteId], references: [id], onDelete: Restrict)
  recommendations OpportunityRecommendation[]
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  @@index([clientId, siteId, state])
  @@index([siteId])
}

model OpportunityRecommendation {
  opportunityId    String
  recommendationId String
  opportunity      Opportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Restrict)

  @@id([opportunityId, recommendationId])
  @@index([recommendationId])
}

model OutboxEvent {
  id            String    @id @default(cuid())
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  status        String    @default("pending")
  attemptCount  Int       @default(0)
  availableAt   DateTime  @default(now())
  sentAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([status, availableAt])
}

model InboxEvent {
  id          String   @id @default(cuid())
  source      String
  externalId  String
  eventType   String
  payloadHash String
  processedAt DateTime @default(now())

  @@unique([source, externalId])
}

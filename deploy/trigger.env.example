# CI deploy identity. Keep these values in the CI secret store, not in Git.
TRIGGER_API_URL=https://trigger.example.internal
TRIGGER_ACCESS_TOKEN=
TRIGGER_PROJECT_REF=proj_sgeo_ops

# Runtime variables for the Trigger project production environment.
# Mark SGEO_INTERNAL_SECRET as a Secret in Trigger.dev before any deploy.
SGEO_INTERNAL_URL=https://geo.example.com
SGEO_INTERNAL_SECRET=
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# A runner with a verified read-only file-secret mount may use this alternative.
# Do not set both sources in the same environment.
# SGEO_INTERNAL_SECRET_FILE=/run/secrets/sgeo_internal_secret

# Never configure DATABASE_URL, direct Postgres credentials, or provider tokens here.

# SGeoOps database only. Do not pass DATABASE_URL to geo-worker.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/geo_content_ops?schema=public"

# Docker Compose uses the service name as host for SGeoOps:
# DATABASE_URL="postgresql://geo_ops:change-me-use-a-secret@postgres:5432/geo_content_ops?schema=public"
# POSTGRES_DB="geo_content_ops"
# POSTGRES_USER="geo_ops"
# POSTGRES_PASSWORD="change-me-use-a-secret"

# Local Trigger development uses its own database and credentials.
TRIGGER_DATABASE_URL="postgresql://trigger_dev:change-me-trigger-secret@trigger-postgres:5432/trigger_dev?schema=public"
TRIGGER_POSTGRES_DB="trigger_dev"
TRIGGER_POSTGRES_USER="trigger_dev"
TRIGGER_POSTGRES_PASSWORD="change-me-trigger-secret"

NEXT_PUBLIC_APP_URL="https://geo.example.com"
PUBLIC_CONTENT_BASE_URL="https://content.example.com"
TXPURO_PUBLIC_HOST="txpuro.com"
TXPURO_PUBLIC_HOST_WWW="www.txpuro.com"
TXPURO_ORIGIN_HOST="geo-origin.winghengtech.com"
TXPURO_DEFAULT_LOCALES="zh-CN,en"
TXPURO_PRIMARY_CTA="self_signup"
TXPURO_SELF_SIGNUP_URL="https://txpuro.com/contact"
TXPURO_DEMO_URL="https://txpuro.com/contact"
TXPURO_CONTACT_URL="https://txpuro.com/contact"
GEO_PROJECT_ID="proj_real_workspace"
GEO_PROJECT_NAME="Your Brand GEO Workspace"
GEO_BRAND="Your Brand"
GEO_PRODUCT="Your product or service"
GEO_LOCALE="zh-CN"
GEO_COMPETITORS=""
GEO_TARGET_KEYWORDS=""
GEO_CANONICAL_DOMAIN="content.example.com"
SEED_DEMO_DATA="false"

BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
SGEO_ALLOW_BOOTSTRAP_SIGNUP="false"
SGEO_ARTIFACT_ROOT="/var/lib/sgeo/artifacts"
SGEO_SECRET_ROOT="/run/secrets"

# geo-worker uses the signed internal platform contract, never DATABASE_URL.
SGEO_INTERNAL_URL="http://geo-ops:3000"
SGEO_INTERNAL_SECRET_FILE="/run/secrets/sgeo_internal_secret"

GEOFLOW_BASE_URL="https://geoflow.example.com"

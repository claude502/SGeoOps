{
  "name": "geo-content-ops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "geo-worker",
    "packages/*"
  ],
  "scripts": {
    "native:build": "node scripts/build-renameat-helper.mjs",
    "postinstall": "npm run native:build",
    "predev": "npm run native:build",
    "dev": "next dev",
    "prebuild": "npm run native:build",
    "build": "next build",
    "start": "next start",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "node prisma/seed.mjs",
    "auth:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run native:build",
    "test": "vitest run",
    "pretest:unit": "npm run native:build",
    "test:unit": "vitest run",
    "pretest:integration": "npm run native:build",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "verify": "npm run prisma:generate && npm run test:unit && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.6.25",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "better-auth": "1.6.25",
    "clsx": "latest",
    "lucide-react": "latest",
    "nanoid": "^5.1.11",
    "next": "latest",
    "pg": "^8.20.0",
    "react": "latest",
    "react-dom": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "dotenv": "^17.4.2",
    "prisma": "^7.8.0",
    "tsx": "4.23.1",
    "typescript": "latest",
    "vitest": "latest"
  }
}
